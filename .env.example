# Google Gemini API Key (Get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Model Selection (e.g. gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional: Timeout Configurations
REQUEST_TIMEOUT_SECONDS=15
GEMINI_HTTP_TIMEOUT_MS=60000
